rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  // ── Story media (audio, images, video) ────────────────────────────────────
    // Path: stories/{uid}/{filename}
    // Only the owning user may write; anyone may read public stories.
    match /stories/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 200 * 1024 * 1024; // 200 MB max
    }

    // ── Profile avatars ───────────────────────────────────────────────────────
    // Path: users/{uid}/avatar_{ts}.{ext}
    match /users/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024; // 5 MB max
    }

    // ── Playlist covers ───────────────────────────────────────────────────────
    // Path: playlists/{uid}/cover_{ts}.{ext}
    match /playlists/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024; // 10 MB max
    }
  }
}